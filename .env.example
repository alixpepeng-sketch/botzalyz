# Nomor pemilik platform (format internasional tanpa +). Dipakai untuk melewati selfmode.
OWNER_NUMBER=6283176204764

# Port server. Render mengisinya otomatis.
PORT=3000

# Folder penyimpanan session. Setiap nomor punya subfolder sendiri.
# Di Render dengan Persistent Disk: /var/data/session
SESSION_DIR=./session

# trace | debug | info | warn | error
LOG_LEVEL=info

# API key dari https://www.remove.bg/api (untuk fitur .removebg)
REMOVEBG_API_KEY=

# Opsional: batas jumlah bot aktif dalam satu server
# MAX_SESSIONS=100
